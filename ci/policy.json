{
  "version": 1,
  "full_on": [
    "ci/**",
    ".github/**",
    "AGENTS.md",
    ".gitattributes",
    ".gitignore"
  ],
  "ignore": [],
  "components": {
    "curriculum": {
      "paths": [
        "curriculum/**",
        "planning/**",
        "tests/test_curriculum_scaffolds.py",
        "tests/test_grade3_reasoning.py"
      ],
      "depends_on": []
    },
    "bank": {
      "paths": [
        "bank/**",
        "assessments/**",
        "exercise_bank/**",
        "tests/test_bank.py",
        "tests/test_unit2_sessions.py",
        "tests/test_unit3_sessions.py"
      ],
      "depends_on": [
        "curriculum"
      ]
    },
    "teaching": {
      "paths": [
        "templates/**",
        "resources/**",
        "tools/build_print_pack.py",
        "tools/verify_print_pack.py",
        "tools/requirements-print.txt",
        "tests/test_teaching_pack.py",
        "tests/test_islamic_studies_prototype.py"
      ],
      "depends_on": [
        "bank",
        "curriculum",
        "documentation"
      ]
    },
    "archive": {
      "paths": [
        "tools/archive_source.py",
        "tools/test_archive_source.py"
      ],
      "depends_on": []
    },
    "guard": {
      "paths": [
        "tools/browser/site_scoped_youtube_guard/build_rules.py",
        "tools/browser/site_scoped_youtube_guard/manifest.json",
        "tools/browser/site_scoped_youtube_guard/acceptance/**",
        "tests/test_site_scoped_youtube_guard.py"
      ],
      "depends_on": []
    },
    "installer": {
      "paths": [
        "tools/browser/site_scoped_youtube_guard/installer_core.py",
        "tools/browser/site_scoped_youtube_guard/wizard.py",
        "tests/test_youtube_guard_installer.py",
        "tools/browser/site_scoped_youtube_guard/platform_policy.py",
        "tests/test_guard_platform_policy.py"
      ],
      "depends_on": [
        "guard"
      ]
    },
    "native": {
      "paths": [
        "tools/browser/site_scoped_youtube_guard/package_native.py",
        "tools/browser/site_scoped_youtube_guard/smoke_gui.py",
        "tests/test_native_youtube_wizard.py"
      ],
      "depends_on": [
        "installer",
        "release"
      ]
    },
    "documentation": {
      "paths": [
        "README.md",
        "CONTRIBUTING.md",
        "docs/**"
      ],
      "depends_on": []
    },
    "factorio": {
      "paths": [
        "curriculum/pilots/factorio/**",
        "tools/factorio_practice.py",
        "tests/test_factorio_practice.py",
        "tools/verify_factorio_integration.py",
        "tools/factorio_integration.lock.json"
      ],
      "depends_on": [
        "curriculum"
      ]
    },
    "release": {
      "paths": [
        "tools/browser/site_scoped_youtube_guard/crx3.py",
        "tools/browser/site_scoped_youtube_guard/release_core.py",
        "tools/browser/site_scoped_youtube_guard/formal/**",
        "tests/test_guard_release.py",
        "tests/test_guard_release_wizard.py"
      ],
      "depends_on": [
        "installer"
      ]
    }
  },
  "suites": {
    "curriculum": {
      "components": [
        "curriculum"
      ],
      "directory": "tests",
      "pattern": "test_curriculum_scaffolds.py"
    },
    "bank": {
      "components": [
        "bank"
      ],
      "directory": "tests",
      "pattern": "test_bank.py"
    },
    "teaching": {
      "components": [
        "teaching"
      ],
      "directory": "tests",
      "pattern": "test_teaching_pack.py"
    },
    "archive": {
      "components": [
        "archive"
      ],
      "directory": "tools",
      "pattern": "test_archive_source.py"
    },
    "guard": {
      "components": [
        "guard"
      ],
      "directory": "tests",
      "pattern": "test_site_scoped_youtube_guard.py"
    },
    "installer": {
      "components": [
        "installer"
      ],
      "directory": "tests",
      "pattern": "test_youtube_guard_installer.py"
    },
    "native": {
      "components": [
        "native"
      ],
      "directory": "tests",
      "pattern": "test_native_youtube_wizard.py"
    },
    "islamic-prototype": {
      "components": [
        "teaching"
      ],
      "directory": "tests",
      "pattern": "test_islamic_studies_prototype.py"
    },
    "unit2-sessions": {
      "components": [
        "bank"
      ],
      "directory": "tests",
      "pattern": "test_unit2_sessions.py"
    },
    "unit3-authored": {
      "components": [
        "curriculum",
        "bank"
      ],
      "directory": "tests",
      "pattern": "test_unit3_authored.py"
    },
    "unit3-sessions": {
      "components": [
        "bank"
      ],
      "directory": "tests",
      "pattern": "test_unit3_sessions.py"
    },
    "reasoning-grade3": {
      "components": [
        "curriculum"
      ],
      "directory": "tests",
      "pattern": "test_grade3_reasoning.py"
    },
    "platform-policy": {
      "components": [
        "installer"
      ],
      "directory": "tests",
      "pattern": "test_guard_platform_policy.py"
    },
    "release": {
      "components": [
        "release"
      ],
      "directory": "tests",
      "pattern": "test_guard_release.py"
    },
    "factorio-practice": {
      "components": [
        "factorio"
      ],
      "directory": "tests",
      "pattern": "test_factorio_practice.py"
    },
    "release-wizard": {
      "components": [
        "release"
      ],
      "directory": "tests",
      "pattern": "test_guard_release_wizard.py"
    }
  }
}
